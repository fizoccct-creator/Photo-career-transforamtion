# Which AI service transforms the photo: gemini | openai | comfyui | demo
# "demo" needs no key: it returns your own photo with a career frame (good for testing the flow).
AI_PROVIDER=openai

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2.5-sunburst

# ComfyUI on your own GPU PC (see COMFYUI.md)
# Address of the PC running ComfyUI. Start ComfyUI with --listen so other computers can reach it.
COMFYUI_URL=http://127.0.0.1:8188
# Workflow saved from ComfyUI with "Export (API)". Start from comfyui-workflow.example.json.
COMFYUI_WORKFLOW=comfyui-workflow.json
# Optional: use this model file instead of the one named in the workflow
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT_SECONDS=180

PORT=3000

# ---- QR download ----
# local = phones must be on the same Wi-Fi as this computer (works now, good for testing)
# s3    = online storage, works on any phone (Cloudflare R2 / Amazon S3 / Backblaze B2). See SHARING.md
SHARE_STORAGE=local
SHARE_TTL_HOURS=24

# Online storage (only for SHARE_STORAGE=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
