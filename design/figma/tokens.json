{
  "$description": "Career Transformation booth: design tokens in the W3C design tokens format (import into Figma variables, or with the Tokens Studio plugin). Text sizes are what the app shows on a 1920 x 1080 screen. Brand colours also live in design/template.json, which the app reads. Layout shares (cards area 32% of the height, stand frame 42% / 60% of the width) are in README.md.",
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": "#FDD00D",
        "$description": "Yellow: Start button, highlights, card borders, progress outline"
      },
      "secondary": {
        "$value": "#202959",
        "$description": "Blue: backgrounds, banner, buttons"
      },
      "light": {
        "$value": "#FFFFFF",
        "$description": "Text"
      },
      "dark": {
        "$value": "#000000",
        "$description": "Shadows, camera background"
      }
    },
    "surface": {
      "background": {
        "$value": "#202959",
        "$description": "Page background (top of the gradient)"
      },
      "background-deep": {
        "$value": "#121731",
        "$description": "Page background (bottom of the gradient)"
      },
      "panel": {
        "$value": "#181F43",
        "$description": "Panels, loading card, setup sections"
      }
    },
    "text": {
      "default": {
        "$value": "#FFFFFF"
      },
      "muted": {
        "$value": "#C1C3D1",
        "$description": "Subtitles, hints"
      },
      "on-primary": {
        "$value": "#202959",
        "$description": "Text on yellow buttons"
      }
    },
    "feedback": {
      "error": {
        "$value": "#DC2626",
        "$description": "Error message"
      },
      "staff-note": {
        "$value": "#B45309",
        "$description": "Staff note: AI credit ran out"
      },
      "success": {
        "$value": "#22C55E",
        "$description": "Setup saved / key works"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": [
          "Segoe UI",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "System font. Use your own by adding .woff2 files in design/fonts/"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      },
      "extrabold": {
        "$value": 800
      },
      "black": {
        "$value": 900
      }
    },
    "size": {
      "$type": "dimension",
      "home-title": {
        "$value": "80px",
        "$description": "Home: Who will you become?"
      },
      "page-title": {
        "$value": "51px",
        "$description": "Classic cards title"
      },
      "screen-title": {
        "$value": "32px",
        "$description": "Result / camera titles"
      },
      "start-button": {
        "$value": "32px"
      },
      "home-subtitle": {
        "$value": "22px"
      },
      "ar-banner": {
        "$value": "18px",
        "$description": "AR banner (one line)"
      },
      "body": {
        "$value": "16px"
      },
      "button": {
        "$value": "16px"
      },
      "small": {
        "$value": "13px",
        "$description": "Status line, labels, staff note"
      },
      "countdown": {
        "$value": "144px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "panel": {
      "$value": "18px"
    },
    "card": {
      "$value": "16px",
      "$description": "About 9% of the card width (180px card)"
    },
    "pill": {
      "$value": "99px",
      "$description": "Buttons, banner, badges"
    },
    "stand-zone": {
      "$value": "28px"
    }
  },
  "size": {
    "$type": "dimension",
    "card-artwork-width": {
      "$value": "750px",
      "$description": "Export size of each career card image (3:4)"
    },
    "card-artwork-height": {
      "$value": "1000px"
    },
    "ar-card-width-landscape": {
      "$value": "180px",
      "$description": "Card on screen at 1920 x 1080, one row of 5"
    },
    "ar-card-width-portrait": {
      "$value": "170px",
      "$description": "Card on screen at 1080 x 1920, rows of 3"
    },
    "min-touch-target": {
      "$value": "64px",
      "$description": "Recommended minimum button height at 1920 x 1080"
    }
  }
}
