        { "text": "FUTURE", "x": 1620, "y": 520, "size": 60, "weight": 700, "color": "secondary" },
        { "text": "{CAREER}", "x": 1620, "y": 615, "size": 92, "weight": 900, "color": "secondary", "maxWidth": 540, "wrap": true },
