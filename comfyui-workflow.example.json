{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" },
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" },
    "_meta": { "title": "selfie" }
  },
  "3": {
    "class_type": "ImageScale",
    "inputs": { "image": ["2", 0], "upscale_method": "lanczos", "width": 896, "height": 1152, "crop": "center" },
    "_meta": { "title": "Resize selfie" }
  },
  "4": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["3", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE Encode" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{PROMPT}}", "clip": ["1", 1] },
    "_meta": { "title": "Positive prompt" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "cartoon, painting, illustration, deformed face, extra fingers, blurry, low quality, watermark, text",
      "clip": ["1", 1]
    },
    "_meta": { "title": "Negative prompt" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["4", 0],
      "seed": 1,
      "steps": 25,
      "cfg": 6,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.6
    },
    "_meta": { "title": "KSampler" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "images": ["8", 0], "filename_prefix": "career" },
    "_meta": { "title": "Save Image" }
  }
}
